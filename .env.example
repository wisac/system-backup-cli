# Restic Backup Configuration

# The primary directory you want to back up
BACKUP_SOURCE="/home/wilson"

# Note: If you want to include specific extra files or directories from outside
# the BACKUP_SOURCE, add their absolute paths to the 'include.txt' file.

# Google Cloud Storage repository settings
# Format: gs:<bucket-name>:/<path/to/repo>
RESTIC_REPOSITORY="gs:my-bucket:/laptop-backup"

# Absolute path to the file containing your restic repository password
# Create this file and ensure it is readable ONLY by the executing user (chmod 600)
RESTIC_PASSWORD_FILE="/opt/restic-backup/.restic_password"

# Google Cloud Service Account Credentials
# Path to the JSON key file downloaded from Google Cloud IAM
GOOGLE_APPLICATION_CREDENTIALS="/opt/restic-backup/gcp_service_key.json"
GOOGLE_PROJECT_ID="project-id-placeholder"

# Additional features
# Set to 'true' to only run backups when the laptop is plugged into AC power (recommended)
CHECK_BATTERY="true"

# Set to 'true' to retry network operations on failure
RETRY_ON_FAILURE="true"
MAX_RETRIES=3
